APP_NAME="Mull2Five"
APP_ENV=development
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-with-a-long-random-value
DATABASE_URL=sqlite:///./mull2five.db
# Supabase (session pooler), vedi HOSTING.md:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Un PostgreSQL gestito regge poche connessioni: senza queste il pool arriva a 80.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# PostgreSQL (docker-compose): l'host "db" vale solo dentro la rete Docker Compose.
POSTGRES_DB=mull2five
POSTGRES_USER=mull2five
POSTGRES_PASSWORD=change-me-in-production

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYMENT_SANDBOX_MOCK=true

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mull2five.local
SMTP_USE_TLS=true

# Redis (cache distribuita + lockout condiviso). Vuoto = fallback in-memory.
REDIS_URL=

# Web Push (VAPID). Genera con: python -m backend.app.core.webpush genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@mull2five.local

# Monitoring: se impostato, /metrics richiede ?token=...
METRICS_TOKEN=

# Alerting operativo (DB giù, errori 5xx). Canali opzionali.
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THROTTLE_SECS=300
WATCHDOG_INTERVAL_SECS=60

# Multi-tenant: header che identifica l'organizzazione corrente
TENANT_HEADER=X-Mull2Five-Org

# Backup automatici (usati da scripts/backup_db.sh)
BACKUP_DIR=./backups
RETENTION_DAYS=14

# Importazione dei tornei di Magic dal Wizards Event Locator (admin → Negozio, o
# python -m backend.app.services.wizards_locator --city Milano). Spenta: le
# condizioni d'uso di Wizards vietano la raccolta automatica; accendila solo
# con il permesso di Wizards (WPN).
WIZARDS_LOCATOR_ENABLED=false

# Sito pubblico: indirizzo per sitemap e robots.txt (vuoto: FRONTEND_URL).
# In build, SITE_URL serve anche a og:image/canonical (default https://mull2five.onrender.com).
SITE_URL=
# Chi gestisce il sito, mostrato in privacy.html e termini.html.
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_ADDRESS=
LEGAL_VAT_ID=
# Statistiche delle visite senza cookie (routers/site.py).
ANALYTICS_ENABLED=true
