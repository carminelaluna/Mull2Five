APP_NAME="Manabind"
APP_ENV=development
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-with-a-long-random-value
DATABASE_URL=sqlite:///./arcana_events.db
# EC2/systemd + SQLite: preferisci una directory gestita da systemd e scrivibile
# dal servizio:
# DATABASE_URL=sqlite:////var/lib/manabind/arcana_events.db

# PostgreSQL (docker-compose): l'host "db" vale solo dentro la rete Docker Compose.
# Su EC2/systemd usa 127.0.0.1 se PostgreSQL gira sulla stessa macchina, oppure
# l'endpoint RDS.
POSTGRES_DB=arcana_events
POSTGRES_USER=arcana
POSTGRES_PASSWORD=change-me-in-production

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYMENT_SANDBOX_MOCK=true

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@manabind.local
SMTP_USE_TLS=true

# Redis (cache distribuita + lockout condiviso). Vuoto = fallback in-memory.
REDIS_URL=

# Web Push (VAPID). Genera con: python -m backend.app.core.webpush genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@manabind.local

# Monitoring: se impostato, /metrics richiede ?token=...
METRICS_TOKEN=

# Alerting operativo (DB giù, errori 5xx). Canali opzionali.
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THROTTLE_SECS=300
WATCHDOG_INTERVAL_SECS=60

# Multi-tenant: header che identifica l'organizzazione corrente
TENANT_HEADER=X-Manabind-Org

# Backup automatici (usati da scripts/backup_db.sh)
BACKUP_DIR=./backups
RETENTION_DAYS=14
