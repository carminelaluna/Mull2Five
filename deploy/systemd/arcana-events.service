[Unit]
Description=Arcana Events FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/arcana-events
EnvironmentFile=/opt/arcana-events/.env
ExecStart=/opt/arcana-events/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

